# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Get this from https://resend.com/api-keys (free tier is fine to start)
RESEND_API_KEY=

# Where contact-form submissions get delivered — your real inbox
CONTACT_TO_EMAIL=

# The "from" address contact-form emails are sent as.
# Must be on a domain you've verified in Resend (https://resend.com/domains),
# OR use Resend's test address below while developing — it works
# immediately with no domain setup, but only delivers to the email you
# signed up to Resend with:
CONTACT_FROM_EMAIL=onboarding@resend.dev
